<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="dns_zone_contract_form" model="ir.ui.view">
        <field name="name">DNS Zone contract Form</field>
        <field name="model">dns.domain_zone</field>
        <field name="inherit_id" ref="base_dns_infrastructure.dns_zone_form" />
        <field name="arch" type="xml">
            <field name="renew_date" position="after">
                <field name="contract_id" />
            </field>
        </field>
    </record>

    <record id="dns_zone_contract_search" model="ir.ui.view">
        <field name="name">DNS Zone Contract Search</field>
        <field name="model">dns.domain_zone</field>
        <field name="inherit_id" ref="base_dns_infrastructure.dns_zone_search" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="contract_id" />

                <separator>
                    <filter
                        name="w_contract"
                        string="With Contract"
                        domain="[('contract_id', '!=', False)]"
                    />
                    <filter
                        name="wo_contract"
                        string="Without Contract"
                        domain="[('contract_id', '=', False)]"
                    />
                </separator>
            </field>
        </field>
    </record>

    <record id="base_dns_infrastructure.dns_zone_action" model="ir.actions.act_window">
        <field
            name="context"
        >{'search_default_contract_id': context.get('active_id')}</field>
    </record>
</odoo>
